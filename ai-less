#!/usr/bin/env bash
# ai-less — a local web page that scores how AI-generated an article reads, then rewrites
# it to read human without changing what it says or how the author sounds.
#
#   ./ai-less                     # serve http://127.0.0.1:5177 and open it in the browser
#   ./ai-less --port 9000 --no-browser
#   ./ai-less --help              # all options
#
# Works from any directory, also through a symlink on $PATH. The first run installs the
# dependencies with npm. Ctrl+C stops the page.
set -euo pipefail

# Resolve our real location, even when invoked via a symlink on $PATH.
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"

command -v node >/dev/null 2>&1 || {
  echo "ai-less needs Node.js 23.6 or newer: https://nodejs.org" >&2
  exit 1
}
IFS=. read -r major minor _ <<<"$(node -p process.versions.node)"
if (( major < 23 || (major == 23 && minor < 6) )); then
  echo "ai-less needs Node.js 23.6 or newer to run TypeScript directly (found $(node -v))." >&2
  exit 1
fi

# Install dependencies on the first run, and again whenever the lockfile changes.
if [[ ! -f "$HERE/node_modules/.package-lock.json" || "$HERE/package-lock.json" -nt "$HERE/node_modules/.package-lock.json" ]]; then
  echo "Installing dependencies…" >&2
  (cd "$HERE" && npm ci --no-audit --no-fund --loglevel=error)
fi

env_file=()
[[ -f "$HERE/.env" ]] && env_file=(--env-file="$HERE/.env")
exec node "${env_file[@]}" "$HERE/server/index.ts" "$@"
