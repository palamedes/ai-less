{
  "name": "ai-less",
  "version": "0.1.0",
  "private": true,
  "description": "Score how AI-generated an article reads, then rewrite it to read human without losing its voice.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.ts",
    "dev": "node --env-file-if-exists=.env --watch server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "@huggingface/transformers": "^4.3.0",
    "diff": "^9.0.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
