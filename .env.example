# Copy to .env and fill in what you need. Everything here is optional.

# --- Claude (needed for rewriting) ---
# How to reach Claude:
#   claude-code  run through the local Claude Code CLI, counted against your Claude plan
#   api          the Anthropic API, billed to prepaid API credits
#   auto         (default) claude-code if the `claude` command is installed, else api
# AI_LESS_BACKEND=auto
# AI_LESS_CLAUDE_BIN=claude

# API backend only. Leave unset to use your `ant auth login` profile instead.
# ANTHROPIC_API_KEY=sk-ant-...

# Model and effort for the rewrite passes (effort: low | medium | high | xhigh | max)
# AI_LESS_REWRITE_MODEL=claude-opus-5-5
# AI_LESS_REWRITE_EFFORT=high

# Model and effort for Claude's second-opinion read and the meaning check
# AI_LESS_JUDGE_MODEL=claude-opus-5-5
# AI_LESS_JUDGE_EFFORT=low

# --- Local detectors ---
# Comma-separated: editlens, tmr (both default), e5 (noisier), or "off".
# EditLens is licensed CC BY-NC-SA 4.0 (non-commercial use only).
# AI_LESS_LOCAL_MODELS=editlens,tmr

# --- Commercial detectors (each is used only if its key is set) ---
# Sapling has a free tier (50k characters/day): https://sapling.ai/user/settings
# SAPLING_API_KEY=
# GPTZERO_API_KEY=
# WINSTON_API_KEY=
# ORIGINALITY_API_KEY=

# --- Server ---
# PORT=5177
# HOST=127.0.0.1
